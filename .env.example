# Base de données MySQL
DB_PASSWORD=your_secure_password
DB_NAME=supinfo_db
DB_HOST=localhost
DB_USER=root

# Backend
PORT=5000

# Auth0 Backend
AUTH0_AUDIENCE=https://your-auth0-tenant.eu.auth0.com/api/v2/
AUTH0_DOMAIN=your-auth0-tenant.eu.auth0.com

# Auth0 Frontend
VITE_AUTH0_DOMAIN=your-auth0-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=your_auth0_client_id
VITE_AUTH0_AUDIENCE=https://your-auth0-tenant.eu.auth0.com/api/v2/

# URL de l'API backend (accessible depuis le navigateur)
VITE_API_URL=http://localhost:5000

# RAWG API Key (pour le frontend)
VITE_RAWG_API_KEY=your_rawg_api_key
