{
  "name": "supinfo-project",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup-env": "node setup-env.js",
    "docker:build": "node setup-env.js && docker compose build",
    "docker:up": "node setup-env.js && docker compose up --build",
    "docker:up:d": "node setup-env.js && docker compose up -d --build",
    "dev": "npm run dev --prefix backend",
    "start": "npm run start --prefix backend",
    "mobile": "npm run lan --prefix frontend-mobile",
    "tunnel": "npm run tunnel --prefix frontend-mobile",
    "frontend": "npm run dev --prefix frontend",
    "install:backend": "npm install --prefix backend",
    "install:mobile": "npm install --prefix frontend-mobile",
    "install:frontend": "npm install --prefix frontend",
    "install": "npm run install:backend && npm run install:mobile && npm run install:frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
